DATABASE_URL=postgresql://postgres:1234@localhost:5432/mini
CORS_ORIGINS=http://localhost:3000

# ── INR payments (Razorpay). Leave blank for demo checkout. ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Public-chain anchoring (optional; requires `pip install web3`) ──
# e.g. Polygon Amoy testnet: https://rpc-amoy.polygon.technology
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CHAIN_CONTRACT_ADDRESS=
CHAIN_NETWORK_NAME=polygon-amoy
CHAIN_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/

# ── Escrow & ledger tuning ──
ESCROW_QUORUM_BPS=2000
ESCROW_VOTING_HOURS=72
LEDGER_DIFFICULTY=3
